:root{font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:#ecf5ff;background:#06101d}*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:24px;background:radial-gradient(circle at 20% 0,#173c63,transparent 38%),#06101d}.card{width:min(100%,560px);padding:32px;border:1px solid #244763;border-radius:22px;background:#0c1b2c;box-shadow:0 30px 70px #0008}.eyebrow{color:#41d6a3;font-weight:700;letter-spacing:.13em;font-size:.75rem}h1{font-size:2rem;margin:.3rem 0}.subtitle,small{color:#aac0d3}.plans{display:grid;gap:10px;margin:24px 0}.plan{display:flex;justify-content:space-between;align-items:center;padding:16px;border:1px solid #31546e;border-radius:12px;cursor:pointer}.plan:has(input:checked){border-color:#41d6a3;background:#113a3b}label{display:block;margin:16px 0 6px}input,textarea{width:100%;border:1px solid #31546e;border-radius:10px;background:#07131f;color:#fff;padding:13px;font:inherit}button{width:100%;margin-top:20px;border:0;border-radius:10px;padding:14px;background:#41d6a3;color:#04221b;font-weight:800;font-size:1rem;cursor:pointer}button:disabled{opacity:.5;cursor:not-allowed}.secondary{background:#244763;color:#fff;margin-top:8px}#payment{margin-top:28px;padding-top:20px;border-top:1px solid #31546e}#qr{display:block;width:230px;height:230px;margin:12px auto;background:#fff;padding:8px;border-radius:10px}textarea{height:82px;resize:none;font-size:.75rem}#status{text-align:center;font-weight:700;color:#41d6a3}
