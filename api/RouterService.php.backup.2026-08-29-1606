<?php
declare(strict_types=1);

require_once __DIR__ . '/config.php';

final class RouterService
{
    public function grantTemporaryAccess(
        string $client,
        int $minutes = 5,
        string $profile = 'payment'
    ): void {
        $this->deleteUser($client);
        $this->createUser($client, $client, $profile, $minutes . 'm', 'Acesso temporario - pagamento PIX');
    }

    public function grantHotspotAccess(
        string $client,
        int $minutes,
        string $profile
    ): void {
        $this->deleteUser($client);
        $this->createUser($client, $client, $profile, $minutes . 'm', 'PIX access - pago');
        $this->disconnectActive($client);
    }

    public function disconnectActive(string $client): void
    {
        $base = rtrim((string) env('MIKROTIK_REST_URL'), '/') . '/ip/hotspot/active';

        $ch = curl_init($base . '?user=' . urlencode($client));
        curl_setopt_array($ch, [
            CURLOPT_HTTPGET => true,
            CURLOPT_USERPWD => env('MIKROTIK_USER') . ':' . env('MIKROTIK_PASS'),
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
            CURLOPT_TIMEOUT => 5,
        ]);
        $out = curl_exec($ch);
        curl_close($ch);

        $active = json_decode((string) $out, true) ?: [];
        foreach ($active as $session) {
            if (($session['user'] ?? '') === $client && isset($session['.id'])) {
                $delCh = curl_init($base . '/' . $session['.id']);
                curl_setopt_array($delCh, [
                    CURLOPT_CUSTOMREQUEST => 'DELETE',
                    CURLOPT_USERPWD => env('MIKROTIK_USER') . ':' . env('MIKROTIK_PASS'),
                    CURLOPT_RETURNTRANSFER => true,
                    CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
                    CURLOPT_TIMEOUT => 5,
                ]);
                curl_exec($delCh);
                curl_close($delCh);
            }
        }
    }

    public function deleteUser(string $client): void
    {
        $base = rtrim((string) env('MIKROTIK_REST_URL'), '/') . '/ip/hotspot/user';

        $ch = curl_init($base . '?name=' . urlencode($client));
        curl_setopt_array($ch, [
            CURLOPT_HTTPGET => true,
            CURLOPT_USERPWD => env('MIKROTIK_USER') . ':' . env('MIKROTIK_PASS'),
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
            CURLOPT_TIMEOUT => 5,
        ]);
        $out = curl_exec($ch);
        curl_close($ch);

        $users = json_decode((string) $out, true) ?: [];
        foreach ($users as $user) {
            if (($user['name'] ?? '') === $client && isset($user['.id'])) {
                $delCh = curl_init($base . '/' . $user['.id']);
                curl_setopt_array($delCh, [
                    CURLOPT_CUSTOMREQUEST => 'DELETE',
                    CURLOPT_USERPWD => env('MIKROTIK_USER') . ':' . env('MIKROTIK_PASS'),
                    CURLOPT_RETURNTRANSFER => true,
                    CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
                    CURLOPT_TIMEOUT => 5,
                ]);
                curl_exec($delCh);
                curl_close($delCh);
            }
        }
    }

    private function createUser(
        string $name,
        string $password,
        string $profile,
        string $limitUptime,
        string $comment
    ): void {
        $url = rtrim((string) env('MIKROTIK_REST_URL'), '/') . '/ip/hotspot/user';

        $payload = [
            'name' => $name,
            'password' => $password,
            'profile' => $profile,
            'limit-uptime' => $limitUptime,
            'comment' => $comment,
        ];

        $ch = curl_init($url);
        curl_setopt_array($ch, [
            CURLOPT_CUSTOMREQUEST => 'PUT',
            CURLOPT_POSTFIELDS => json_encode(
                $payload,
                JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR
            ),
            CURLOPT_HTTPHEADER => [
                'Content-Type: application/json',
            ],
            CURLOPT_USERPWD =>
                env('MIKROTIK_USER') . ':' . env('MIKROTIK_PASS'),
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_HTTP_VERSION => CURL_HTTP_VERSION_1_1,
            CURLOPT_TIMEOUT => 10,
        ]);

        $out = curl_exec($ch);
        $code = curl_getinfo($ch, CURLINFO_RESPONSE_CODE);
        $error = curl_error($ch);
        curl_close($ch);

        if ($out === false || $code < 200 || $code >= 300) {
            throw new RuntimeException(
                'RouterOS: ' . ($error ?: (string) $out)
            );
        }
    }
}
